{
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"type\":\"subagent_start\",\"data\":{\"agentId\":\"'$(echo $ARGUMENTS | jq -r '.agent_id // \"unknown\"')'\",\"name\":\"'$(echo $ARGUMENTS | jq -r '.agent_name // \"Agent\"')'\"}}' >> .claude/agent-events.jsonl"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"type\":\"subagent_stop\",\"data\":{\"agentId\":\"'$(echo $ARGUMENTS | jq -r '.agent_id // \"unknown\"')'\"}}' >> .claude/agent-events.jsonl"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"type\":\"task_created\",\"data\":{\"taskId\":\"'$(echo $ARGUMENTS | jq -r '.task_id // \"t-'$(date +%s)'\"')'\",\"description\":\"'$(echo $ARGUMENTS | jq -r '.task_description // \"Task\"')'\"}}' >> .claude/agent-events.jsonl"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"type\":\"task_completed\",\"data\":{\"taskId\":\"'$(echo $ARGUMENTS | jq -r '.task_id // \"unknown\"')'\"}}' >> .claude/agent-events.jsonl"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"type\":\"tool_use\",\"data\":{\"tool\":\"'$(echo $ARGUMENTS | jq -r '.tool_name')'\",\"input\":\"'$(echo $ARGUMENTS | jq -r '.tool_input | tostring | .[0:50]')'\"}}' >> .claude/agent-events.jsonl"
          }
        ]
      }
    ]
  }
}
